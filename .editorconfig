# EditorConfig is awesome: https://EditorConfig.org
#
# Kept in step with oxfmt.json deliberately: an editor that indents differently from the
# formatter turns every file someone opens into a diff nobody meant to make.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,svelte,json}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
