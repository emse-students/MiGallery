{
  "name": "migallery",
  "version": "2.1.0",
  "private": true,
  "description": "MiGallery, by MiTV",
  "keywords": [
    "gallery",
    "node",
    "svelte",
    "sveltekit",
    "vite"
  ],
  "homepage": "https://github.com/emse-students/MiGallery#readme",
  "license": "SEE LICENSE IN LICENSE",
  "author": "DeMASKe",
  "repository": {
    "type": "git",
    "url": "https://github.com/emse-students/MiGallery.git"
  },
  "files": [
    "build/",
    "src/",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint -c .oxlintrc.json . && sh ./scripts/run-oxvelte.sh lint --config oxvelte.config.json src",
    "lint:fix": "oxlint -c .oxlintrc.json --fix . && sh ./scripts/run-oxvelte.sh lint --config oxvelte.config.json --fix src",
    "format": "oxfmt -c ./oxfmt.json --write .",
    "format:check": "oxfmt -c ./oxfmt.json --check .",
    "deps:install": "bun install",
    "ci:install": "bun install --frozen-lockfile",
    "ci:build": "bun install --frozen-lockfile && bun run build",
    "start": "bun build/index.js",
    "package": "bun run build && bun -e \"require('fs').mkdirSync('build/artifacts',{ recursive: true })\" && bun pm pack --destination build/artifacts",
    "version:show": "bun -e \"console.log(require('./package.json').version)\"",
    "db:init": "bun ./scripts/init-db.cjs",
    "db:backup": "bun ./scripts/backup-db.cjs",
    "db:inspect": "bun ./scripts/inspect-db.cjs",
    "immich:cleanup-test-albums": "bun ./scripts/cleanup-immich-test-albums.mjs",
    "test:cleanup": "bun ./scripts/cleanup-test-artifacts.cjs",
    "validate": "bun scripts/ci-local.mjs",
    "test": "bun scripts/test-with-server.mjs",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:unit": "bun --bun vitest run",
    "test:albums": "bun --bun vitest run tests/albums.test.ts",
    "test:users": "bun --bun vitest run tests/users.test.ts",
    "test:admin": "bun --bun vitest run tests/admin-auth.test.ts",
    "test:people": "bun --bun vitest run tests/people-photoscv.test.ts",
    "test:immich": "bun --bun vitest run tests/immich-proxy.test.ts",
    "test:favorites": "bun --bun vitest run tests/favorites-external.test.ts",
    "test:e2e": "bun --bun vitest run tests/e2e-integration.test.ts",
    "cleanup:chunked-temp": "bun ./scripts/cleanup-chunked-temp.js",
    "db:reset-users": "bun ./scripts/reset-users-for-authentik.cjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.38.0",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "browserslist": "^4.28.8",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.1",
    "tar": "^7.5.22",
    "typescript": "~6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "cookie": "^0.7.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
