{
	"name": "migallery",
	"private": true,
	"version": "2.0.0",
	"description": "MiGallery, by MiTV",
	"type": "module",
	"author": "DeMASKe",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "https://github.com/emse-students/MiGallery.git"
	},
	"homepage": "https://github.com/emse-students/MiGallery#readme",
	"keywords": [
		"sveltekit",
		"svelte",
		"vite",
		"node",
		"gallery"
	],
	"files": [
		"build/",
		"src/",
		"README.md"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint -c .oxlintrc.json src scripts && bash ./scripts/run-oxvelte.sh lint --config oxvelte.config.json src",
		"lint:fix": "oxlint -c .oxlintrc.json --fix src scripts && bash ./scripts/run-oxvelte.sh lint --config oxvelte.config.json --fix src",
		"format": "oxfmt -c ./oxfmt.json --write .",
		"format:check": "oxfmt -c ./oxfmt.json --check .",
		"deps:install": "bun install",
		"ci:install": "bun install --frozen-lockfile",
		"ci:build": "bun install --frozen-lockfile && bun run build",
		"start": "node build/index.js",
		"package": "bun run build && node -e \"require('fs').mkdirSync('build/artifacts',{ recursive: true })\" && bun pm pack --destination build/artifacts",
		"version:show": "node -e \"console.log(require('./package.json').version)\"",
		"db:init": "node ./scripts/init-db.cjs",
		"db:backup": "node ./scripts/backup-db.cjs",
		"db:inspect": "node ./scripts/inspect-db.cjs",
		"immich:cleanup-test-albums": "node ./scripts/cleanup-immich-test-albums.mjs",
		"test:cleanup": "node ./scripts/cleanup-test-artifacts.cjs",
		"validate": "node scripts/ci-local.mjs",
		"test": "node scripts/test-with-server.mjs",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:unit": "vitest run",
		"test:albums": "vitest run tests/albums.test.ts",
		"test:users": "vitest run tests/users.test.ts",
		"test:admin": "vitest run tests/admin-auth.test.ts",
		"test:people": "vitest run tests/people-photoscv.test.ts",
		"test:immich": "vitest run tests/immich-proxy.test.ts",
		"test:favorites": "vitest run tests/favorites-external.test.ts",
		"test:e2e": "vitest run tests/e2e-integration.test.ts",
		"cleanup:chunked-temp": "node ./scripts/cleanup-chunked-temp.js",
		"db:reset-users": "node ./scripts/reset-users-for-authentik.cjs"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.24.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/form-data": "^2.5.2",
		"@vitest/coverage-v8": "^4.1.11",
		"autoprefixer": "^10.5.4",
		"husky": "^9.1.7",
		"oxfmt": "^0.59.0",
		"oxlint": "^1.80.0",
		"postcss": "^8.5.26",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.1",
		"tar": "^7.5.22",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.4.2",
		"form-data": "^4.0.6",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"lucide-svelte": "^1.0.1",
		"sharp": "^0.35.3",
		"undici": "^8.10.0"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
